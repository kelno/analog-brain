    "i18next-http-backend": "^4.0.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "react-switch": "^7.1.0",
    "sonner": "^2.0.7",
    "strip-json-comments": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
